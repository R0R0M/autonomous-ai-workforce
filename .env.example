# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://workforce:workforce@localhost:5432/workforce"

# Anthropic
ANTHROPIC_API_KEY=""
# Model used by all three agents. claude-opus-4-8 = best quality (recommended);
# claude-haiku-4-5 = fastest/cheapest (fine for trying the pipeline).
# The agent layer auto-adapts thinking/effort params per model generation.
ANTHROPIC_MODEL="claude-opus-4-8"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# GitHub OAuth app (callback URL: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# 32-byte hex key for encrypting stored GitHub tokens — generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=""

# Where repository workspaces are cloned (absolute or relative to project root)
WORKSPACES_DIR="./workspaces"

# Max Coder fix iterations per cycle before the run is marked FAILED
MAX_FIX_ITERATIONS="3"

# Agent backend: "api" (default — bills API credits) or "sdk" (Claude Agent SDK —
# runs through the local Claude Code login and bills that Claude plan instead).
AGENT_BACKEND="api"

# Stripe billing — prepaid credits, metered usage. Leave empty to disable billing.
STRIPE_SECRET_KEY=""
# Only needed in production (Stripe CLI/dashboard webhook signing secret)
STRIPE_WEBHOOK_SECRET=""
# Public URL of this app (used for Stripe redirect URLs)
APP_URL="http://localhost:3000"
# Free credit granted to every new account
TRIAL_CREDIT_USD="1"
